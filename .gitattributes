# Shell scripts must keep LF endings — CRLF makes Linux fail with
# "bad interpreter: /usr/bin/env bash^M".
*.sh    text eol=lf
*.bash  text eol=lf

# Windows scripts stay CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Ready-built bundles are over GitHub's 100 MB file limit: Git LFS.
release/*.tgz filter=lfs diff=lfs merge=lfs -text
